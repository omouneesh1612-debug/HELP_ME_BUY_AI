# ── Google Gemini API ───────────────────────────────────────────────
# Get your API key from Google AI Studio: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# ── Serper (Google Shopping search) ─────────────────────────────────
# Get your API key from Serper: https://serper.dev  (2500 free searches/month)
SERPER_API_KEY=your_serper_api_key_here

# ── Reddit API (Currently unused/disabled in recommender) ───────────
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=recommender_app/1.0 by YourRedditUsername
