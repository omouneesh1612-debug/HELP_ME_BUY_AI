# ── Anthropic (Claude) ──────────────────────────────────────────────
# Get from: https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_key_here

# ── Serper (Google Shopping search) ─────────────────────────────────
# Get from: https://serper.dev  (2500 free searches/month, no card needed)
SERPER_API_KEY=your_serper_key_here

# ── Reddit API ───────────────────────────────────────────────────────
# Go to: https://www.reddit.com/prefs/apps
# Click "Create another app" → choose "script"
# Name: anything  |  redirect uri: http://localhost:8080
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=recommender_app/1.0 by YourRedditUsername
